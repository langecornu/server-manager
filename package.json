{
  "name": "server-manager",
  "productName": "Server Manager",
  "version": "1.0.0",
  "private": true,
  "description": "The front door to every local app: an inventory of the Node apps running on this computer, with their ports and a link to open each one.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/server.test.js",
    "autostart:install": "node scripts/autostart.js install",
    "autostart:remove": "node scripts/autostart.js remove",
    "autostart:status": "node scripts/autostart.js status"
  },
  "engines": {
    "node": ">=18"
  }
}
